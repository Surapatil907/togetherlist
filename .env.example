# ====================================================================
# TogetherList Configuration (Supabase Free Tier)
# Copy this file to .env or configure in .streamlit/secrets.toml
# ====================================================================

# Your Supabase Project URL (found in Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon Public Key (SAFE for client apps, found in Project Settings -> API)
# NEVER put your service_role secret key here!
SUPABASE_KEY=your_supabase_anon_key_here
